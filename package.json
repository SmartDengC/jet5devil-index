{
  "name": "vuepress-starter",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "wiki:dev": "vuepress dev wiki",
    "wiki:build": "vuepress build wiki --clean-cache --clean-temp",
    "wiki:preview": "http-server wiki -d 0",
    "lint:fix": "prettier . --write",
    "iron:dev": "vuepress dev iron",
    "iron:build": "vuepress build iron --clean-cache --clean-temp",
    "iron:preview": "http-server iron -d 0",
    "sci:dev": "vuepress dev sci",
    "sci:build": "vuepress build sci --clean-cache --clean-temp",
    "sci:preview": "http-server sci -d 0",
    "vp-update": "vp-update"
  },
  "dependencies": {
    "@iconify/json": "^2.2.382",
    "@pengzhanbo/utils": "^2.1.0",
    "@vuepress/bundler-vite": "2.0.0-rc.24",
    "@vuepress/plugin-baidu-analytics": "2.0.0-rc.112",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.112",
    "@vuepress/plugin-llms": "2.0.0-rc.112",
    "@vuepress/shiki-twoslash": "2.0.0-rc.112",
    "gitmojis": "^3.15.0",
    "katex": "^0.16.22",
    "mermaid": "^11.11.0",
    "tinyglobby": "^0.2.15",
    "vue": "^3.5.21",
    "vuepress": "2.0.0-rc.24",
    "vuepress-theme-plume": "1.0.0-rc.163",
    "cz-conventional-changelog": "^3.3.0"
  },
  "devDependencies": {
    "@pengzhanbo/eslint-config-vue": "^1.37.0",
    "@types/express": "^5.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "http-server": "^14.1.1",
    "is-ci": "^4.1.0",
    "tsconfig-vuepress": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-plugin-font": "^5.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "5.4.16"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "floating-vue@5.2.2": "patches/floating-vue@5.2.2.patch"
    }
  }
}
