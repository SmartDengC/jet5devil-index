{
  "name": "vuepress-starter",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "wiki:dev": "vuepress dev wiki",
    "wiki:build": "vuepress build wiki --clean-cache --clean-temp",
    "preview": "http-server wiki -d 0",
    "lint:fix": "prettier . --write",
    "iron:dev": "vuepress dev iron",
    "iron:build": "vuepress build iron --clean-cache --clean-temp",
    "iron:preview": "http-server iron -d 0",
    "sci:dev": "vuepress dev sci",
    "sci:build": "vuepress build sci --clean-cache --clean-temp",
    "sci:preview": "http-server sci -d 0"
  },
  "dependencies": {
    "@iconify/json": "^2.2.324",
    "@vuepress/bundler-vite": "2.0.0-rc.20",
    "@vuepress/plugin-baidu-analytics": "2.0.0-rc.91",
    "@vuepress/plugin-google-analytics": "2.0.0-rc.80",
    "cz-conventional-changelog": "^3.3.0",
    "katex": "^0.16.21",
    "mermaid": "^11.6.0",
    "sass-embedded": "^1.85.1",
    "vue": "^3.5.13",
    "vuepress": "2.0.0-rc.20",
    "vuepress-theme-plume": "1.0.0-rc.140"
  },
  "devDependencies": {
    "@pengzhanbo/prettier-config": "^1.26.0",
    "@types/express": "^5.0.0",
    "http-server": "^14.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "tsconfig-vuepress": "^5.2.1",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
